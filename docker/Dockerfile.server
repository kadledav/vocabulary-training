# vocab-server image (design §12.4, R-83): a static musl binary on distroless
# "static" (no shell, no package manager, no libc), running as 65532:65532.
#
# Every input is pinned (R-90) and dated by tools/dep-age.py: base images by
# tag and digest, Debian packages by exact version, crates by Cargo.lock.
# Build from the repository root (for the machine's own platform; the
# release builds linux/amd64 and linux/arm64, each natively on its own
# runner, since rustc under QEMU emulation is unreliable):
#   docker build -f docker/Dockerfile.server -t vocab-server .

# ── build stage ─────────────────────────────────────────────────────────────
# The Rust release must match rust-toolchain.toml (checked by repo-guard);
# rust-toolchain.toml itself is not in the build context, so the image's
# own toolchain is used and nothing else is installed by rustup.
FROM rust:1.99.0-slim-trixie@sha256:2752b332db73fdbb7dc576f06c82ed1f312005784ef913d7e04a28f5f55dc581 AS build

# musl toolchain for the static build (the bundled SQLite is C), from a fixed
# snapshot of the Debian archive, so the pinned versions stay installable
# when trixie moves on. The dry run first proves that apt installs exactly
# these three pinned packages and nothing unpinned.
# To update: pick a snapshot timestamp at least 14 days old
# (https://snapshot.debian.org/archive/debian/?year=…), take the versions of
# musl, musl-dev and musl-tools in its dists/trixie/main/binary-amd64/Packages
# (and the same versions in binary-arm64/Packages: both platforms are built),
# and change the timestamp and all six pins together (Renovate cannot).
RUN echo 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20261101T000000Z trixie main' > /etc/apt/sources.list \
 && rm -f /etc/apt/sources.list.d/debian.sources \
 && apt-get update \
 && test "$(apt-get install -s --no-install-recommends musl=1.2.5-3.1~deb13u1 musl-dev=1.2.5-3.1~deb13u1 musl-tools=1.2.5-3.1~deb13u1 | grep -c '^Inst ')" = 3 \
 && apt-get install -y --no-install-recommends musl=1.2.5-3.1~deb13u1 musl-dev=1.2.5-3.1~deb13u1 musl-tools=1.2.5-3.1~deb13u1 \
 && rm -rf /var/lib/apt/lists/*

# Native build for the platform being built (TARGETARCH is set by BuildKit
# and Buildah): the matching musl target of the image's (pinned) Rust
# release, and Debian's musl-gcc (native) for the bundled SQLite.
ARG TARGETARCH
ENV CC_x86_64_unknown_linux_musl=musl-gcc \
    CC_aarch64_unknown_linux_musl=musl-gcc
RUN case "$TARGETARCH" in \
      amd64) echo x86_64-unknown-linux-musl ;; \
      arm64) echo aarch64-unknown-linux-musl ;; \
      *) echo "unsupported TARGETARCH '$TARGETARCH'" >&2; exit 1 ;; \
    esac > /rust-target \
 && target="$(cat /rust-target)" \
 && rustup target add "$target"

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates crates
COPY web web
RUN target="$(cat /rust-target)" \
 && cargo build --release --locked --target "$target" -p vocab-server \
 && install -D -m 0755 "target/$target/release/vocab-server" /out/vocab-server \
 && mkdir -p /out/data

# ── runtime stage ───────────────────────────────────────────────────────────
FROM gcr.io/distroless/static-debian13:nonroot@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329

# The licence label is the combined expression of tools/licenses.py (--check
# keeps them in sync): the project is MIT; the rest is linked third-party code.
LABEL org.opencontainers.image.title="vocabulary-training" \
      org.opencontainers.image.description="Vocabulary training app (vocab-server)" \
      org.opencontainers.image.source="https://github.com/kadledav/vocabulary-training" \
      org.opencontainers.image.licenses="MIT AND Apache-2.0 AND BSD-3-Clause AND Zlib AND Unicode-3.0 AND MPL-2.0 AND Apache-2.0 WITH LLVM-exception"

COPY --from=build /out/vocab-server /vocab-server
# Licences: the project's own and the third-party notices of everything
# linked into the binary (generated by tools/licenses.py, checked in CI).
COPY LICENSE THIRD-PARTY-NOTICES.txt /licenses/
# The exact crate versions in the binary, for the SBOM generator (syft).
COPY Cargo.lock /usr/share/doc/vocab-server/Cargo.lock
# The one mount point. /data belongs to the image's default user, so a fresh
# named volume is writable; a bind mount gets its ownership from the host
# (deploy/README.md runs the app as 3101:3101). The app creates the cache
# directory (/data/cache) itself. Configuration comes from the environment
# (VOCAB_PUBLIC_ORIGIN, …); there is no config file and there are no secrets.
COPY --from=build --chown=65532:65532 /out/data /data

USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/vocab-server"]
CMD ["serve"]
